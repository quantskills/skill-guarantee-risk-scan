{
  "name": "guarantee-risk-scan",
  "version": "1.0.0",
  "description": "A-share cumulative guarantee risk scanning BUILD",
  "author": "fuzijun",
  "created_date": "2026-07-12",
  "tags": ["quant", "build", "monitoring", "guarantee-risk"],
  "category": "build-monitoring",
  "spec": {
    "build_id": "B01",
    "build_name": "guarantee-risk-scan",
    "build_type": "result-type",
    "data_source": "PandaData"
  },
  "dependencies": {
    "python": ">=3.8",
    "pandas": ">=1.3.0",
    "numpy": ">=1.20.0",
    "pandadata": "latest"
  },
  "scripts": {
    "build": "scripts/build.py",
    "test": "scripts/test.py"
  },
  "config": {
    "ratio_threshold": 50.0,
    "excess_threshold": 0.0,
    "high_debt_threshold": 0.0
  },
  "production": {
    "output_format": "parquet",
    "update_frequency": "daily",
    "retention_period": "1_year"
  }
}
